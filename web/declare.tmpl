    function _dpr_setup() {
        const canvas = document.getElementById('canvas');
        const dpr = window.devicePixelRatio || 1;
        const vw = window.visualViewport ? window.visualViewport.width : window.innerWidth;
        const vh = window.visualViewport ? window.visualViewport.height : window.innerHeight;
        // Set internal framebuffer to DPR-scaled size for crisp rendering
        canvas.width = Math.floor(vw * dpr);
        canvas.height = Math.floor(vh * dpr);
        // CSS size stays at viewport size
        canvas.style.width = vw + 'px';
        canvas.style.height = vh + 'px';
        // Expose dpr for Python
        window._dpr = dpr;
        window._vw = vw;
        window._vh = vh;
    }

    let _rotate_dismissed = false;
    function _is_portrait() {
        // Use window.orientation when available (iOS Safari supports this)
        if (typeof window.orientation !== 'undefined') {
            return window.orientation === 0 || window.orientation === 180;
        }
        // Fallback for modern browsers
        return window.innerWidth < window.innerHeight;
    }
    function _check_orientation() {
        if (_rotate_dismissed) return;
        const overlay = document.getElementById('rotate-overlay');
        const canvas = document.getElementById('canvas');
        if (!overlay || !canvas) return;
        if (_is_portrait()) {
            overlay.style.display = 'flex';
            canvas.style.display = 'none';
        } else {
            overlay.style.display = 'none';
            canvas.style.display = 'block';
        }
    }
    function _dismiss_rotate() {
        _rotate_dismissed = true;
        const overlay = document.getElementById('rotate-overlay');
        const canvas = document.getElementById('canvas');
        if (overlay) overlay.style.display = 'none';
        if (canvas) canvas.style.display = 'block';
    }
    window.addEventListener('resize', _check_orientation);
    window.addEventListener('orientationchange', _check_orientation);

    async function custom_onload(debug_hidden) {
        // this is called before anything python is loaded
        // make your js customization here
        console.log(__FILE__, "custom_onload")

        // Force-hide ALL debug UI elements for a clean production look
        pyconsole.hidden = true
        system.hidden = true
        transfer.hidden = debug_hidden
        info.hidden = true
        box.hidden =  true

        // Lock landscape on mobile
        if (screen.orientation && screen.orientation.lock) {
            try { await screen.orientation.lock('landscape'); } catch (e) {}
        }

        _dpr_setup();
        _check_orientation();

        show_infobox()
    }

    function custom_prerun(){
        // no python main and no (MEMFS + VFS) yet.
        console.log(__FILE__, "custom_prerun")

    }

    function custom_postrun(){
